.venv/
__pycache__/
*.pyc
node_modules/
web/dist/
web/public/core/
.DS_Store

# Assay exports are regenerable from the LIMS store, which is committed.
lims_store/exports/

# The browser's runtime is staged from node_modules and the pyodide CDN by
# web/scripts/stage-pyodide.mjs, with the wheel's sha256 checked against
# pyodide's own lock file. Regenerable, and 18 MB.
web/public/pyodide/
web/.playwright-cli/
web/*.png
web/*.yaml

# The key for the site's one function, for local development only. It is read
# by vite.config.js into the dev server's process and never reaches the page;
# on Vercel it is a project environment variable and no file exists.
web/.env
web/.env.*

# The Vercel CLI's working directory: the linked project's ids and the local
# build output. Regenerable. It sits at the repository root because the Vercel
# project's Root Directory is `web`, and the CLI resolves that from the root.
.vercel/
